🛠 Service Worker (sw.js) - ऑफलाइन सपोर्ट

self.addEventListener('install', (event) => {
    event.waitUntil(
        caches.open('ecc-cache-v1').then((cache) => {
            return cache.addAll([
                '/',
                '/index.html',
                '/styles.css',
                '/icons/ecc-icon-192.png',
                '/icons/ecc-icon-512.png'
            ]);
        })
    );
});

self.addEventListener('fetch', (event) => {
    event.respondWith(
        caches.match(event.request).then((response) => {
            return response || fetch(event.request);
        })
    );
});

